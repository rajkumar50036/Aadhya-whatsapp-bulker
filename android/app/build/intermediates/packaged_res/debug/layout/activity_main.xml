<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical">

    <!-- Top App Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="#0b1120">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Aadhya WhatsApp Bulker"
                android:textColor="@color/text_white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/badgeServiceStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ Auto-Send"
                android:background="#132a22"
                android:textColor="@color/primary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Top Navigation Tabs (Sender, History, Templates, Anti-Ban) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:background="#0b1120"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabSender"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="📱 Sender"
                android:textSize="12sp"
                android:backgroundTint="@color/primary"
                android:textColor="@color/bg_dark"
                android:layout_marginEnd="6dp"
                app:cornerRadius="19dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabHistory"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="📜 History"
                android:textSize="12sp"
                android:backgroundTint="@color/card_bg"
                android:textColor="@color/text_white"
                android:layout_marginEnd="6dp"
                app:cornerRadius="19dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabTemplates"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="📋 Templates"
                android:textSize="12sp"
                android:backgroundTint="@color/card_bg"
                android:textColor="@color/text_white"
                android:layout_marginEnd="6dp"
                app:cornerRadius="19dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabAntiBan"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="🛡️ Anti-Ban"
                android:textSize="12sp"
                android:backgroundTint="@color/card_bg"
                android:textColor="@color/text_white"
                app:cornerRadius="19dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Content Frame -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- ==================== TAB 1: SENDER VIEW ==================== -->
        <ScrollView
            android:id="@+id/viewSender"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <!-- Accessibility Warning Banner (shows only if disabled) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardAccessibilityBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="#132a22"
                    app:strokeColor="@color/primary"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="10dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Enable Auto-Send in Accessibility Settings to send automatically!"
                            android:textColor="@color/text_white"
                            android:textSize="11sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnEnableAccessibility"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="Enable"
                            android:textSize="11sp"
                            android:backgroundTint="@color/primary"
                            android:textColor="@color/bg_dark"
                            app:cornerRadius="6dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- SECTION 1: Phone Numbers Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/card_bg"
                    app:strokeColor="@color/border_color"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <!-- Mode Switcher (Single vs Bulk) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="10dp">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnModeSingle"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="36dp"
                                android:layout_weight="1"
                                android:text="Single Number"
                                android:textSize="11sp"
                                android:textColor="@color/text_white"
                                android:layout_marginEnd="4dp"
                                app:cornerRadius="6dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnModeBulk"
                                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                                android:layout_width="0dp"
                                android:layout_height="36dp"
                                android:layout_weight="1"
                                android:text="Bulk Mode"
                                android:textSize="11sp"
                                android:backgroundTint="@color/primary"
                                android:textColor="@color/bg_dark"
                                android:layout_marginStart="4dp"
                                app:cornerRadius="6dp" />
                        </LinearLayout>

                        <!-- Country Code & Header -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Enter Phone Numbers"
                                android:textColor="@color/text_white"
                                android:textStyle="bold"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/txtCountBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 Numbers"
                                android:textColor="@color/primary"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Phone Numbers Input Box -->
                        <EditText
                            android:id="@+id/editPhoneNumbers"
                            android:layout_width="match_parent"
                            android:layout_height="110dp"
                            android:layout_marginTop="8dp"
                            android:background="#0b1120"
                            android:padding="10dp"
                            android:textColor="@color/text_white"
                            android:textColorHint="@color/text_gray"
                            android:hint="Type or paste numbers with country code:\n919876543210\n919876543211\n(One number per line or separated by commas)"
                            android:gravity="top|start"
                            android:textSize="12sp"
                            android:inputType="textMultiLine" />

                        <!-- Actions (Clear, Sample Numbers) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="end"
                            android:layout_marginTop="8dp">

                            <TextView
                                android:id="@+id/btnClearNumbers"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Clear"
                                android:textColor="#f87171"
                                android:textSize="11sp"
                                android:padding="6dp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- SECTION 2: Message Composer Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/card_bg"
                    app:strokeColor="@color/border_color"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Message Box"
                                android:textColor="@color/text_white"
                                android:textStyle="bold"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/txtCharCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 chars"
                                android:textColor="@color/text_gray"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <!-- Quick Emoji Bar -->
                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:scrollbars="none"
                            android:layout_marginTop="8dp">

                            <LinearLayout
                                android:id="@+id/layoutEmojis"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">
                                <!-- Emojis inserted programmatically -->
                            </LinearLayout>
                        </HorizontalScrollView>

                        <!-- Quick Formatting Buttons (Bold, Italic, Strikethrough) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="6dp">

                            <TextView
                                android:id="@+id/btnFormatBold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="*Bold*"
                                android:textColor="@color/primary"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:background="#0b1120"
                                android:padding="6dp"
                                android:layout_marginEnd="6dp" />

                            <TextView
                                android:id="@+id/btnFormatItalic"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="_Italic_"
                                android:textColor="@color/primary"
                                android:textSize="11sp"
                                android:background="#0b1120"
                                android:padding="6dp"
                                android:layout_marginEnd="6dp" />

                            <TextView
                                android:id="@+id/btnFormatStrike"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="~Strike~"
                                android:textColor="@color/primary"
                                android:textSize="11sp"
                                android:background="#0b1120"
                                android:padding="6dp"
                                android:layout_marginEnd="6dp" />

                            <TextView
                                android:id="@+id/btnInsertName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="{name}"
                                android:textColor="@color/accent"
                                android:textSize="11sp"
                                android:background="#0b1120"
                                android:padding="6dp" />
                        </LinearLayout>

                        <!-- Message Text Area -->
                        <EditText
                            android:id="@+id/editMessage"
                            android:layout_width="match_parent"
                            android:layout_height="110dp"
                            android:layout_marginTop="8dp"
                            android:background="#0b1120"
                            android:padding="10dp"
                            android:textColor="@color/text_white"
                            android:textColorHint="@color/text_gray"
                            android:hint="Type your message here... Emojis and links are fully supported!"
                            android:gravity="top|start"
                            android:textSize="12sp"
                            android:inputType="textMultiLine" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- SECTION 3: Attach Media Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:cardBackgroundColor="@color/card_bg"
                    app:strokeColor="@color/border_color"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Send Files (Photos &amp; Videos)"
                            android:textColor="@color/text_white"
                            android:textStyle="bold"
                            android:textSize="13sp" />

                        <!-- Pick File Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPickMedia"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="8dp"
                            android:text="📸 Choose Photo or Video"
                            android:textSize="12sp"
                            android:textColor="@color/primary"
                            app:strokeColor="@color/primary"
                            app:cornerRadius="8dp" />

                        <!-- Attached File Preview Banner -->
                        <LinearLayout
                            android:id="@+id/layoutAttachedMedia"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="#0b1120"
                            android:padding="8dp"
                            android:layout_marginTop="8dp"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/txtAttachedMediaName"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="photo.jpg"
                                android:textColor="@color/text_white"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/btnRemoveMedia"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="✕ Remove"
                                android:textColor="#f87171"
                                android:textSize="11sp"
                                android:padding="6dp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- SECTION 4: Start Bulk Sending Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStartBulkCampaign"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="🚀 START BULK SENDING"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/primary"
                    android:textColor="@color/bg_dark"
                    app:cornerRadius="10dp" />

                <!-- Campaign Live Progress Text -->
                <TextView
                    android:id="@+id/txtLiveCampaignProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ready to launch campaign."
                    android:textColor="@color/text_gray"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="20dp" />

            </LinearLayout>
        </ScrollView>

        <!-- ==================== TAB 2: HISTORY VIEW ==================== -->
        <LinearLayout
            android:id="@+id/viewHistory"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/txtHistoryTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Chat History (Saved Messages)"
                    android:textColor="@color/text_white"
                    android:textStyle="bold"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExportCSV"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Export CSV"
                    android:textColor="@color/primary"
                    android:textSize="11sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClearHistory"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Clear"
                    android:textColor="#f87171"
                    android:textSize="11sp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerHistory"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>

        <!-- ==================== TAB 3: TEMPLATES VIEW ==================== -->
        <ScrollView
            android:id="@+id/viewTemplates"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/layoutTemplatesList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select a Template to Insert"
                    android:textColor="@color/text_white"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp" />

                <!-- Templates inserted programmatically -->
            </LinearLayout>
        </ScrollView>

        <!-- ==================== TAB 4: ANTI-BAN CONTROLS VIEW ==================== -->
        <ScrollView
            android:id="@+id/viewAntiBan"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/card_bg"
                    app:strokeColor="@color/border_color"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="10dp"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🛡️ Anti-Ban Sending Delay"
                            android:textColor="@color/text_white"
                            android:textStyle="bold"
                            android:textSize="14sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="8dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Delay Between Messages"
                                android:textColor="@color/text_gray"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/txtAntiBanDelayValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="3 seconds"
                                android:textColor="@color/accent"
                                android:textStyle="bold"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <SeekBar
                            android:id="@+id/seekAntiBanDelay"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:max="15"
                            android:progress="3" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Tip: A 3 to 5 second delay ensures WhatsApp sees your activity as natural human messaging."
                            android:textColor="@color/text_gray"
                            android:textSize="11sp"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Anti-Ban Best Practices Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#132a22"
                    app:strokeColor="@color/primary"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✅ WhatsApp Anti-Ban Safety Rules"
                            android:textColor="@color/primary"
                            android:textStyle="bold"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="1. Always include country code (e.g., 91 for India).\n2. Use personalized text or emoji variations.\n3. Send in batches of 20 to 50 numbers.\n4. Avoid spamming unknown numbers who might report."
                            android:textColor="@color/text_white"
                            android:textSize="11sp"
                            android:lineSpacingExtra="4dp"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </ScrollView>

    </FrameLayout>
</LinearLayout>
